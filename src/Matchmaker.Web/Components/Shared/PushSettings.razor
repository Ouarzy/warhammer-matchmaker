@using Matchmaker.Web.Push
@inject PushOptions Options

@* Rendu par js/push.js, qui seul sait si ce navigateur est abonné. *@
@if (Options.Enabled)
{
    <section class="card push">
        <h2><Icon Name="bell" /> Notifications</h2>
        <push-settings data-key="@Options.PublicKey"><p class="hint">Chargement…</p></push-settings>
    </section>
}
