<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Matchmaker.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        // Menu burger (téléphone) : se referme dès qu'on choisit une entrée.
        document.addEventListener("click", (event) => {
            const toggle = document.getElementById("menu-toggle");
            if (toggle && event.target.closest(".sidebar a, .sidebar button")) toggle.checked = false;
        });

        window.matchmakerTimeZone = () => Intl.DateTimeFormat().resolvedOptions().timeZone;

        // Dates (<LocalTime>) dans le fuseau du lecteur. On n'ajoute qu'un attribut : le texte reste à Blazor.
        const localTime = new Intl.DateTimeFormat("fr-FR", { weekday: "short", day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" });
        const localize = () => document.querySelectorAll("time.local-time").forEach((time) => {
            const iso = time.getAttribute("datetime");
            if (time.dataset.localFor === iso) return;
            time.dataset.local = localTime.format(new Date(iso));
            time.dataset.localFor = iso;
        });
        localize();
        new MutationObserver(localize).observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ["datetime"] });
    </script>
</body>

</html>
