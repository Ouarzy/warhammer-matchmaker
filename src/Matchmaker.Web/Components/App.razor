<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Matchmaker.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        // Menu burger (téléphone) : se referme dès qu'on choisit une entrée.
        document.addEventListener("click", (event) => {
            const toggle = document.getElementById("menu-toggle");
            if (toggle && event.target.closest(".sidebar a, .sidebar button")) toggle.checked = false;
        });
    </script>
</body>

</html>
