@page "/lists/{Id:guid}"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Matchmaker.Domain.ArmyLists
@using Matchmaker.Web.Accounts
@using Matchmaker.Web.ArmyLists
@inject ArmyListService Lists
@inject NavigationManager Navigation

@if (_list is not null)
{
    <PageTitle>@_list.Name</PageTitle>

    <header class="list-header">
        <h1>@_list.Name</h1>
        <p>@(_list.Faction ?? "Faction inconnue") · @_list.Format.Name · @_list.Roster.Units.Count unités · édition @_list.Roster.Edition</p>
    </header>

    @if (_isOwner)
    {
        <section class="card owner-actions">
            <EditForm Model="Rename" FormName="rename" OnValidSubmit="RenameAsync" Enhance class="inline-form">
                <DataAnnotationsValidator />
                <label>
                    Nom
                    <InputText @bind-Value="Rename!.Name" maxlength="@ArmyList.NameMaxLength" />
                </label>
                <button type="submit" class="button">Renommer</button>
                <ValidationMessage For="() => Rename.Name" class="error" />
            </EditForm>

            <form method="post" @formname="delete" @onsubmit="DeleteAsync">
                <AntiforgeryToken />
                <button type="submit" class="button danger" onclick="return confirm('Supprimer définitivement cette liste ?')">Supprimer</button>
            </form>
        </section>
    }

    <RosterView Roster="_list.Roster" />
}

@code {
    [Parameter] public Guid Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "rename")]
    private RenameModel? Rename { get; set; }

    private ArmyList? _list;
    private bool _isOwner;
    private Matchmaker.Domain.Players.PlayerId _me;

    protected override async Task OnInitializedAsync()
    {
        _me = SteamAuthentication.PlayerIdOf((await AuthenticationState).User);
        _list = await Lists.FindAsync(Id);
        if (_list is null)
        {
            Navigation.NotFound();
            return;
        }

        _isOwner = _list.IsOwnedBy(_me);
        Rename ??= new RenameModel { Name = _list.Name };
    }

    private async Task RenameAsync()
    {
        if (await Lists.RenameAsync(_me, Id, Rename!.Name))
            _list = await Lists.FindAsync(Id);
    }

    private async Task DeleteAsync()
    {
        if (await Lists.DeleteAsync(_me, Id))
            Navigation.NavigateTo("/lists");
    }
    private sealed class RenameModel
    {
        [Required(ErrorMessage = "Donnez un nom à votre liste.")]
        [MaxLength(ArmyList.NameMaxLength, ErrorMessage = "Le nom est limité à 60 caractères.")]
        public string Name { get; set; } = "";
    }
}
