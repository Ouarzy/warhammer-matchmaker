@page "/lists/{Id:guid}"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Matchmaker.Domain.ArmyLists
@using Matchmaker.Web.Accounts
@using Matchmaker.Web.ArmyLists
@inject ArmyListService Lists
@inject NavigationManager Navigation

@if (_list is not null)
{
    <PageTitle>@_list.Name</PageTitle>

    <header class="list-header">
        <h1>@_list.Name</h1>
        <p>@(_list.Faction ?? "Faction inconnue")@(_list.Detachment is { } detachment ? $" · Détachement {detachment}" : "") · @_list.Format.Name · @_list.Type.Label() · @_list.Roster.Units.Count unités · édition @_list.Roster.Edition</p>
    </header>

    @if (_isOwner)
    {
        <section class="card">
            <EditForm Model="Edit" FormName="edit" OnValidSubmit="UpdateAsync" Enhance class="list-settings">
                <DataAnnotationsValidator />
                <label class="wide">
                    Nom
                    <InputText @bind-Value="Edit!.Name" maxlength="@ArmyList.NameMaxLength" />
                    <ValidationMessage For="() => Edit.Name" class="error" />
                </label>
                <label>
                    Détachement
                    <InputText @bind-Value="Edit!.Detachment" maxlength="@ArmyList.DetachmentMaxLength" placeholder="Facultatif" />
                    <ValidationMessage For="() => Edit.Detachment" class="error" />
                </label>
                <label>
                    Type de liste
                    <InputSelect @bind-Value="Edit!.Type">
                        @foreach (var type in ArmyListTypes.Offered)
                        {
                            <option value="@type">@type.Label()</option>
                        }
                    </InputSelect>
                </label>
                <div class="actions wide">
                    <button type="submit" class="button"><Icon Name="edit" /> Enregistrer</button>
                    @* Le bouton envoie le formulaire de suppression, à part : deux formulaires ne s'imbriquent pas. *@
                    <button type="submit" form="delete-list" class="button danger" onclick="return confirm('Supprimer définitivement cette liste ?')"><Icon Name="trash" /> Supprimer</button>
                </div>
            </EditForm>

            <form id="delete-list" method="post" @formname="delete" @onsubmit="DeleteAsync">
                <AntiforgeryToken />
            </form>
        </section>
    }

    <RosterView Roster="_list.Roster" />
}

@code {
    [Parameter] public Guid Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "edit")]
    private EditModel? Edit { get; set; }

    private ArmyList? _list;
    private bool _isOwner;
    private Matchmaker.Domain.Players.PlayerId _me;

    protected override async Task OnInitializedAsync()
    {
        _me = SteamAuthentication.PlayerIdOf((await AuthenticationState).User);
        _list = await Lists.FindAsync(Id);
        if (_list is null)
        {
            Navigation.NotFound();
            return;
        }

        _isOwner = _list.IsOwnedBy(_me);
        Edit ??= new EditModel { Name = _list.Name, Detachment = _list.Detachment, Type = _list.Type };
    }

    private async Task UpdateAsync()
    {
        if (await Lists.UpdateAsync(_me, Id, Edit!.Name, Edit.Detachment, Edit.Type))
            _list = await Lists.FindAsync(Id);
    }

    private async Task DeleteAsync()
    {
        if (await Lists.DeleteAsync(_me, Id))
            Navigation.NavigateTo("/lists");
    }
    private sealed class EditModel
    {
        [Required(ErrorMessage = "Donnez un nom à votre liste.")]
        [MaxLength(ArmyList.NameMaxLength, ErrorMessage = "Le nom est limité à 512 caractères.")]
        public string Name { get; set; } = "";

        [MaxLength(ArmyList.DetachmentMaxLength, ErrorMessage = "Le détachement est limité à 128 caractères.")]
        public string? Detachment { get; set; }

        public ArmyListType Type { get; set; }
    }
}
