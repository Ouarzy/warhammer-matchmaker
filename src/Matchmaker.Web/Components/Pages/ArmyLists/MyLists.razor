@page "/lists"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Matchmaker.Domain.ArmyLists
@using Matchmaker.Domain.Matchmaking
@using Matchmaker.Web.Accounts
@using Matchmaker.Web.ArmyLists
@using Microsoft.AspNetCore.WebUtilities
@inject ArmyListService Lists
@inject NavigationManager Navigation

<PageTitle>Mes listes</PageTitle>

<h1><Icon Name="lists" /> Mes listes</h1>

@if (_lists.Count == 0)
{
    <p>Vous n'avez encore aucune liste.</p>
    <p><a href="/lists?import=1" class="button"><Icon Name="import" /> Importer</a></p>
}
else
{
    <form method="get" action="/lists" class="list-search" role="search">
        @if (_order != ArmyListOrder.Default)
        {
            <input type="hidden" name="sort" value="@_order.Column" />
            <input type="hidden" name="dir" value="@(_order.Descending ? "desc" : "asc")" />
        }
        <input type="search" name="q" value="@Query" placeholder="Rechercher une liste par son nom" aria-label="Rechercher une liste par son nom" />
        <button type="submit" class="button"><Icon Name="search" /> Rechercher</button>
        <a href="/lists?import=1" class="button secondary"><Icon Name="import" /> Importer</a>
        @if (!string.IsNullOrWhiteSpace(Query))
        {
            <a href="@ListsUrl(_order, null)">Tout afficher</a>
        }
    </form>

    @if (Shown.Count == 0)
    {
        <p>Aucune liste ne contient « @Query ».</p>
    }
    else
    {
        <form method="post" @formname="favorite" @onsubmit="ToggleFavoriteAsync" class="table-scroll">
            <AntiforgeryToken />
            <table>
                <thead>
                    <tr>
                        <th><span class="visually-hidden">Favori</span></th>
                        @SortableHeader(ArmyListOrder.Name, "Nom")
                        @SortableHeader(ArmyListOrder.Faction, "Faction")
                        @SortableHeader(ArmyListOrder.Detachment, "Détachement")
                        @SortableHeader(ArmyListOrder.Format, "Format")
                        @SortableHeader(ArmyListOrder.Type, "Type")
                        @SortableHeader(ArmyListOrder.Units, "Unités")
                        @SortableHeader(ArmyListOrder.Imported, "Importée le")
                    </tr>
                </thead>
                <tbody>
                    @foreach (var list in Shown)
                    {
                        <tr>
                            <td>
                                <button type="submit" name="FavoriteListId" value="@list.Id" class="favorite-toggle @(list.IsFavorite ? "active" : "")"
                                        title="@(list.IsFavorite ? "Retirer des favoris" : "Choisir comme favorite (proposée par défaut pour une partie)")"
                                        aria-label="@(list.IsFavorite ? "Retirer des favoris" : "Choisir comme favorite")" aria-pressed="@(list.IsFavorite ? "true" : "false")">
                                    <Icon Name="star" Class="@(list.IsFavorite ? "filled" : null)" />
                                </button>
                            </td>
                            <td><a href="/lists/@list.Id"><Icon Name="eye" /> @list.Name</a></td>
                            <td>@(list.Faction ?? "Inconnue")</td>
                            <td>@(list.Detachment ?? "–")</td>
                            <td>@GameFormats.LabelOf(list.Format)</td>
                            <td>@list.Type.Label()</td>
                            <td>@list.Roster.Units.Count</td>
                            <td>@list.ImportedAt.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </form>
    }
}

@if (_importOpen)
{
    <a href="/lists" class="modal-backdrop" aria-label="Fermer" tabindex="-1"></a>
    <section class="card modal" role="dialog" aria-modal="true" aria-labelledby="import-title">
        <h2 id="import-title"><Icon Name="import" /> Importer une liste</h2>

        <EditForm Model="Import" FormName="import" OnValidSubmit="ImportAsync" Enhance class="form">
            <DataAnnotationsValidator />

            <label>
                Code YellowScribe
                <InputText @bind-Value="Import!.Code" placeholder="0c6cfa93" autocomplete="off" />
            </label>
            <ValidationMessage For="() => Import!.Code" class="error" />

            <label>
                <span>Nom de la liste <span class="hint">(facultatif : faction et points par défaut)</span></span>
                <InputText @bind-Value="Import!.Name" placeholder="Adeptus Custodes – 2000 pts" maxlength="@ArmyList.NameMaxLength" />
            </label>
            <ValidationMessage For="() => Import!.Name" class="error" />

            <label>
                <span>Détachement <span class="hint">(facultatif : YellowScribe ne le transmet pas)</span></span>
                <InputText @bind-Value="Import!.Detachment" placeholder="Shield Host" maxlength="@ArmyList.DetachmentMaxLength" />
            </label>
            <ValidationMessage For="() => Import!.Detachment" class="error" />

            <label>
                <span>Version du MFM <span class="hint">(facultatif)</span></span>
                <InputText @bind-Value="Import!.MfmVersion" placeholder="3.4" maxlength="@ArmyList.MfmVersionMaxLength" />
            </label>
            <ValidationMessage For="() => Import!.MfmVersion" class="error" />

            <label>
                <span>Force disposition <span class="hint">(facultatif)</span></span>
                <InputText @bind-Value="Import!.ForceDisposition" maxlength="@ArmyList.ForceDispositionMaxLength" />
            </label>
            <ValidationMessage For="() => Import!.ForceDisposition" class="error" />

            <label>
                Format
                <InputSelect @bind-Value="Import!.Format">
                    @foreach (var format in GameFormats.Of(GameSystem.Warhammer40k))
                    {
                        <option value="@format.Name">@GameFormats.LabelOf(format)</option>
                    }
                </InputSelect>
            </label>

            <label>
                Type de liste
                <InputSelect @bind-Value="Import!.Type">
                    @foreach (var type in ArmyListTypes.Offered)
                    {
                        <option value="@type">@type.Label()</option>
                    }
                </InputSelect>
            </label>

            @if (_importError is not null)
            {
                <p class="error" role="alert">@_importError</p>
            }

            <div class="actions">
                <button type="submit" class="button"><Icon Name="import" /> Importer</button>
                <a href="/lists" class="button secondary" data-modal-close>Annuler</a>
            </div>
        </EditForm>
    </section>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "import")]
    private ImportModel? Import { get; set; }

    [SupplyParameterFromForm(FormName = "favorite")]
    private Guid? FavoriteListId { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    private string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    private string? SortColumn { get; set; }

    [SupplyParameterFromQuery(Name = "dir")]
    private string? SortDirection { get; set; }

    [SupplyParameterFromQuery(Name = "import")]
    private string? ImportRequested { get; set; }

    private IReadOnlyList<ArmyList> Shown => _order.Apply(string.IsNullOrWhiteSpace(Query)
        ? _lists
        : _lists.Where(l => l.Name.Contains(Query.Trim(), StringComparison.CurrentCultureIgnoreCase)));

    private IReadOnlyList<ArmyList> _lists = [];
    private string? _importError;
    private bool _importOpen;
    private ArmyListOrder _order = ArmyListOrder.Default;

    protected override async Task OnInitializedAsync()
    {
        _order = ArmyListOrder.Parse(SortColumn, SortDirection);
        // Un import envoyé qui revient ici a été refusé : la fenêtre reste ouverte pour afficher l'erreur.
        _importOpen = ImportRequested is not null || Import is not null;
        // Pas d'initialiseur sur la propriété : un envoi du formulaire la remplacerait par null.
        Import ??= new ImportModel();
        _lists = await Lists.ListOwnedByAsync(await CurrentPlayerAsync());
    }

    private async Task ImportAsync()
    {
        var format = GameFormats.Find(GameSystem.Warhammer40k, Import!.Format);
        if (format is null)
        {
            _importError = "Format inconnu.";
            return;
        }

        ArmyList list;
        try
        {
            list = await Lists.ImportAsync(await CurrentPlayerAsync(), Import.Code, Import.Name, format, Import.Detachment, Import.Type, Import.MfmVersion, Import.ForceDisposition);
        }
        catch (RosterImportException e)
        {
            _importError = e.Message;
            return;
        }

        Navigation.NavigateTo($"/lists/{list.Id}");
    }

    private async Task ToggleFavoriteAsync()
    {
        var me = await CurrentPlayerAsync();
        if (FavoriteListId is { } id && await Lists.ToggleFavoriteAsync(me, id))
            _lists = await Lists.ListOwnedByAsync(me);
    }

    private RenderFragment SortableHeader(string column, string label) =>
        @<th aria-sort="@(column != _order.Column ? null : _order.Descending ? "descending" : "ascending")">
            <a href="@ListsUrl(_order.Next(column), Query)" class="sort-link">@label @if (column == _order.Column) { <span aria-hidden="true">@(_order.Descending ? "▼" : "▲")</span> }</a>
        </th>;

    private static string ListsUrl(ArmyListOrder order, string? query)
    {
        var parameters = new Dictionary<string, string?> { ["sort"] = order.Column, ["dir"] = order.Descending ? "desc" : "asc" };
        if (!string.IsNullOrWhiteSpace(query)) parameters["q"] = query;
        return QueryHelpers.AddQueryString("/lists", parameters);
    }

    private async Task<Matchmaker.Domain.Players.PlayerId> CurrentPlayerAsync() =>
        SteamAuthentication.PlayerIdOf((await AuthenticationState).User);

    private sealed class ImportModel
    {
        [Required(ErrorMessage = "Collez le code YellowScribe de votre liste.")]
        [RegularExpression(@"^\s*[0-9a-fA-F]{8}\s*$", ErrorMessage = "Un code YellowScribe contient 8 caractères (chiffres et lettres de a à f).")]
        public string Code { get; set; } = "";

        [MaxLength(ArmyList.NameMaxLength, ErrorMessage = "Le nom est limité à 512 caractères.")]
        public string? Name { get; set; }

        [MaxLength(ArmyList.DetachmentMaxLength, ErrorMessage = "Le détachement est limité à 128 caractères.")]
        public string? Detachment { get; set; }

        [MaxLength(ArmyList.MfmVersionMaxLength, ErrorMessage = "La version du MFM est limitée à 32 caractères.")]
        public string? MfmVersion { get; set; }

        [MaxLength(ArmyList.ForceDispositionMaxLength, ErrorMessage = "La force disposition est limitée à 128 caractères.")]
        public string? ForceDisposition { get; set; }

        public string Format { get; set; } = GameFormats.StrikeForce.Name;

        public ArmyListType Type { get; set; } = ArmyListType.Hybrid;
    }
}
