@page "/lists"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Matchmaker.Domain.ArmyLists
@using Matchmaker.Domain.Matchmaking
@using Matchmaker.Web.Accounts
@using Matchmaker.Web.ArmyLists
@inject ArmyListService Lists
@inject NavigationManager Navigation

<PageTitle>Mes listes</PageTitle>

<h1>Mes listes</h1>

<section class="card">
    <h2>Importer une liste</h2>
    <p class="hint">
        Dans ForceOrg ou New Recruit, exportez votre liste vers YellowScribe puis collez le code obtenu.
        Un code n'est valable que 10 minutes : la liste est copiée ici au moment de l'import.
    </p>

    <EditForm Model="Import" FormName="import" OnValidSubmit="ImportAsync" Enhance class="form">
        <DataAnnotationsValidator />

        <label>
            Code YellowScribe
            <InputText @bind-Value="Import.Code" placeholder="0c6cfa93" autocomplete="off" />
        </label>
        <ValidationMessage For="() => Import.Code" class="error" />

        <label>
            Nom de la liste <span class="hint">(facultatif : faction et format par défaut)</span>
            <InputText @bind-Value="Import.Name" placeholder="Adeptus Custodes – Strike Force" maxlength="@ArmyList.NameMaxLength" />
        </label>
        <ValidationMessage For="() => Import.Name" class="error" />

        <label>
            Format
            <InputSelect @bind-Value="Import.Format">
                @foreach (var format in GameFormats.Of(GameSystem.Warhammer40k))
                {
                    <option value="@format.Name">@format.Name</option>
                }
            </InputSelect>
        </label>

        @if (_importError is not null)
        {
            <p class="error" role="alert">@_importError</p>
        }

        <button type="submit" class="button">Importer</button>
    </EditForm>
</section>

@if (_lists.Count == 0)
{
    <p>Vous n'avez encore aucune liste.</p>
}
else
{
    <div class="table-scroll">
        <table>
            <thead>
                <tr><th>Nom</th><th>Faction</th><th>Format</th><th>Unités</th><th>Importée le</th></tr>
            </thead>
            <tbody>
                @foreach (var list in _lists)
                {
                    <tr>
                        <td><a href="/lists/@list.Id">@list.Name</a></td>
                        <td>@(list.Faction ?? "Inconnue")</td>
                        <td>@list.Format.Name</td>
                        <td>@list.Roster.Units.Count</td>
                        <td>@list.ImportedAt.ToString("dd/MM/yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "import")]
    private ImportModel Import { get; set; } = new();

    private IReadOnlyList<ArmyList> _lists = [];
    private string? _importError;

    protected override async Task OnInitializedAsync()
    {
        _lists = await Lists.ListOwnedByAsync(await CurrentPlayerAsync());
    }

    private async Task ImportAsync()
    {
        var format = GameFormats.Find(GameSystem.Warhammer40k, Import.Format);
        if (format is null)
        {
            _importError = "Format inconnu.";
            return;
        }

        ArmyList list;
        try
        {
            list = await Lists.ImportAsync(await CurrentPlayerAsync(), Import.Code, Import.Name, format);
        }
        catch (RosterImportException e)
        {
            _importError = e.Message;
            return;
        }

        Navigation.NavigateTo($"/lists/{list.Id}");
    }

    private async Task<Matchmaker.Domain.Players.PlayerId> CurrentPlayerAsync() =>
        SteamAuthentication.PlayerIdOf((await AuthenticationState).User);

    private sealed class ImportModel
    {
        [Required(ErrorMessage = "Collez le code YellowScribe de votre liste.")]
        [RegularExpression(@"^\s*[0-9a-fA-F]{8}\s*$", ErrorMessage = "Un code YellowScribe contient 8 caractères (chiffres et lettres de a à f).")]
        public string Code { get; set; } = "";

        [MaxLength(ArmyList.NameMaxLength, ErrorMessage = "Le nom est limité à 60 caractères.")]
        public string? Name { get; set; }

        public string Format { get; set; } = GameFormats.StrikeForce.Name;
    }
}
