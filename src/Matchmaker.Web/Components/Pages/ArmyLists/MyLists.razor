@page "/lists"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Matchmaker.Domain.ArmyLists
@using Matchmaker.Domain.Matchmaking
@using Matchmaker.Web.Accounts
@using Matchmaker.Web.ArmyLists
@inject ArmyListService Lists
@inject NavigationManager Navigation

<PageTitle>Mes listes</PageTitle>

<h1><Icon Name="lists" /> Mes listes</h1>

<section class="card">
    <h2><Icon Name="import" /> Importer une liste</h2>

    <EditForm Model="Import" FormName="import" OnValidSubmit="ImportAsync" Enhance class="form">
        <DataAnnotationsValidator />

        <label>
            Code YellowScribe
            <InputText @bind-Value="Import!.Code" placeholder="0c6cfa93" autocomplete="off" />
        </label>
        <ValidationMessage For="() => Import!.Code" class="error" />

        <label>
            Nom de la liste <span class="hint">(facultatif : faction et format par défaut)</span>
            <InputText @bind-Value="Import!.Name" placeholder="Adeptus Custodes – Strike Force" maxlength="@ArmyList.NameMaxLength" />
        </label>
        <ValidationMessage For="() => Import!.Name" class="error" />

        <label>
            Détachement <span class="hint">(facultatif : YellowScribe ne le transmet pas)</span>
            <InputText @bind-Value="Import!.Detachment" placeholder="Shield Host" maxlength="@ArmyList.DetachmentMaxLength" />
        </label>
        <ValidationMessage For="() => Import!.Detachment" class="error" />

        <label>
            Format
            <InputSelect @bind-Value="Import!.Format">
                @foreach (var format in GameFormats.Of(GameSystem.Warhammer40k))
                {
                    <option value="@format.Name">@format.Name (@GameFormats.PointsOf(format) pts)</option>
                }
            </InputSelect>
        </label>

        <label>
            Type de liste
            <InputSelect @bind-Value="Import!.Type">
                @foreach (var type in ArmyListTypes.Offered)
                {
                    <option value="@type">@type.Label()</option>
                }
            </InputSelect>
        </label>

        @if (_importError is not null)
        {
            <p class="error" role="alert">@_importError</p>
        }

        <button type="submit" class="button"><Icon Name="import" /> Importer</button>
    </EditForm>
</section>

@if (_lists.Count == 0)
{
    <p>Vous n'avez encore aucune liste.</p>
}
else
{
    <form method="get" action="/lists" class="list-search" role="search">
        <input type="search" name="q" value="@Query" placeholder="Rechercher une liste par son nom" aria-label="Rechercher une liste par son nom" />
        <button type="submit" class="button"><Icon Name="search" /> Rechercher</button>
        @if (!string.IsNullOrWhiteSpace(Query))
        {
            <a href="/lists">Tout afficher</a>
        }
    </form>

    @if (Shown.Count == 0)
    {
        <p>Aucune liste ne contient « @Query ».</p>
    }
    else
    {
        <form method="post" @formname="favorite" @onsubmit="ToggleFavoriteAsync" class="table-scroll">
            <AntiforgeryToken />
            <table>
                <thead>
                    <tr><th><span class="visually-hidden">Favori</span></th><th>Nom</th><th>Faction</th><th>Détachement</th><th>Format</th><th>Type</th><th>Unités</th><th>Importée le</th></tr>
                </thead>
                <tbody>
                    @foreach (var list in Shown)
                    {
                        <tr>
                            <td>
                                <button type="submit" name="FavoriteListId" value="@list.Id" class="favorite-toggle @(list.IsFavorite ? "active" : "")"
                                        title="@(list.IsFavorite ? "Retirer des favoris" : "Choisir comme favorite (proposée par défaut pour une partie)")"
                                        aria-label="@(list.IsFavorite ? "Retirer des favoris" : "Choisir comme favorite")" aria-pressed="@(list.IsFavorite ? "true" : "false")">
                                    <Icon Name="star" Class="@(list.IsFavorite ? "filled" : null)" />
                                </button>
                            </td>
                            <td><a href="/lists/@list.Id"><Icon Name="eye" /> @list.Name</a></td>
                            <td>@(list.Faction ?? "Inconnue")</td>
                            <td>@(list.Detachment ?? "–")</td>
                            <td>@list.Format.Name</td>
                            <td>@list.Type.Label()</td>
                            <td>@list.Roster.Units.Count</td>
                            <td>@list.ImportedAt.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </form>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "import")]
    private ImportModel? Import { get; set; }

    [SupplyParameterFromForm(FormName = "favorite")]
    private Guid? FavoriteListId { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    private string? Query { get; set; }

    private IReadOnlyList<ArmyList> Shown => string.IsNullOrWhiteSpace(Query)
        ? _lists
        : [.. _lists.Where(l => l.Name.Contains(Query.Trim(), StringComparison.CurrentCultureIgnoreCase))];

    private IReadOnlyList<ArmyList> _lists = [];
    private string? _importError;

    protected override async Task OnInitializedAsync()
    {
        // Pas d'initialiseur sur la propriété : un envoi du formulaire la remplacerait par null.
        Import ??= new ImportModel();
        _lists = await Lists.ListOwnedByAsync(await CurrentPlayerAsync());
    }

    private async Task ImportAsync()
    {
        var format = GameFormats.Find(GameSystem.Warhammer40k, Import!.Format);
        if (format is null)
        {
            _importError = "Format inconnu.";
            return;
        }

        ArmyList list;
        try
        {
            list = await Lists.ImportAsync(await CurrentPlayerAsync(), Import.Code, Import.Name, format, Import.Detachment, Import.Type);
        }
        catch (RosterImportException e)
        {
            _importError = e.Message;
            return;
        }

        Navigation.NavigateTo($"/lists/{list.Id}");
    }

    private async Task ToggleFavoriteAsync()
    {
        var me = await CurrentPlayerAsync();
        if (FavoriteListId is { } id && await Lists.ToggleFavoriteAsync(me, id))
            _lists = await Lists.ListOwnedByAsync(me);
    }

    private async Task<Matchmaker.Domain.Players.PlayerId> CurrentPlayerAsync() =>
        SteamAuthentication.PlayerIdOf((await AuthenticationState).User);

    private sealed class ImportModel
    {
        [Required(ErrorMessage = "Collez le code YellowScribe de votre liste.")]
        [RegularExpression(@"^\s*[0-9a-fA-F]{8}\s*$", ErrorMessage = "Un code YellowScribe contient 8 caractères (chiffres et lettres de a à f).")]
        public string Code { get; set; } = "";

        [MaxLength(ArmyList.NameMaxLength, ErrorMessage = "Le nom est limité à 512 caractères.")]
        public string? Name { get; set; }

        [MaxLength(ArmyList.DetachmentMaxLength, ErrorMessage = "Le détachement est limité à 128 caractères.")]
        public string? Detachment { get; set; }

        public string Format { get; set; } = GameFormats.StrikeForce.Name;

        public ArmyListType Type { get; set; } = ArmyListType.Hybrid;
    }
}
