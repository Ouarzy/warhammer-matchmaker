@page "/players"
@using Matchmaker.Domain.Players
@using Matchmaker.Web.Accounts
@using Matchmaker.Web.Matches
@inject PlayerAccounts Accounts

<PageMeta Title="Joueurs" Description="Retrouvez les joueurs de Warhammer 40 000 sur Tabletop Simulator : Elo, listes d'armée et historique de parties." Path="/players" />

<h1><Icon Name="players" /> Joueurs</h1>

<form method="get" action="/players" class="inline-form" role="search">
    <label>
        Nom du joueur
        <input type="search" name="q" value="@Q" minlength="@PlayerAccounts.SearchMinLength" placeholder="Rechercher un joueur…" />
    </label>
    <button type="submit" class="button"><Icon Name="search" /> Rechercher</button>
</form>

@if (Searching && _players.Count == 0)
{
    <p>Aucun joueur ne correspond à « @Q ». <a href="/players">Voir tous les joueurs</a></p>
}
else
{
    @if (Searching)
    {
        <p class="hint">Résultats pour « @Q » · <a href="/players">Voir tous les joueurs</a></p>
    }
    else
    {
        <p class="hint">@_directory.Total joueurs, par ordre alphabétique.</p>
    }
    <div class="table-scroll">
        <table class="ranking">
            <thead><tr><th>Joueur</th><th>Elo</th><th>Parties classées</th></tr></thead>
            <tbody>
                @foreach (var player in _players)
                {
                    <tr><td><PlayerLink Player="player" /></td><td><strong>@player.Rating.Value</strong></td><td>@player.RankedGamesPlayed</td></tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Searching)
    {
        <Pagination Number="_directory.Number" PageCount="_directory.PageCount" Url="@(n => $"/players?page={n}")" Label="Pages des joueurs" />
    }
}

@code {
    [SupplyParameterFromQuery] public string? Q { get; set; }
    [SupplyParameterFromQuery] public int? Page { get; set; }

    private IReadOnlyList<Player> _players = [];
    private Page<Player> _directory = new([], 1, PlayerAccounts.DirectoryPageSize, 0);

    private bool Searching => !string.IsNullOrWhiteSpace(Q);

    protected override async Task OnParametersSetAsync()
    {
        if (Searching)
        {
            _players = await Accounts.SearchAsync(Q!);
            return;
        }
        _directory = await Accounts.DirectoryPageAsync(Page ?? 1);
        _players = _directory.Items;
    }
}
