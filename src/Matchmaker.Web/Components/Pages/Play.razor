@page "/play"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@using Matchmaker.Domain.ArmyLists
@using Matchmaker.Domain.Matches
@using Matchmaker.Domain.Matchmaking
@using Matchmaker.Domain.Players
@using Matchmaker.Domain.Results
@using Matchmaker.Web.Accounts
@using Matchmaker.Web.ArmyLists
@using Matchmaker.Web.Matches
@using Matchmaker.Web.Matchmaking
@inject MatchmakingCoordinator Coordinator
@inject PlayerNotifier Notifier
@inject IServiceScopeFactory ScopeFactory
@inject IJSRuntime JS
@inject TimeProvider Time

<PageTitle>Jouer</PageTitle>

<h1>Jouer</h1>

@if (_error is not null)
{
    <p class="error" role="alert">@_error</p>
}

@if (_match is not null)
{
    var opponent = _match.OpponentOf(_me);
    <section class="card status in-match">
        @switch (_match.Status)
        {
            case MatchStatus.Accepted:
                <h2>Match accepté : à vous de jouer !</h2>
                <Opponent Ticket="opponent" Player="_opponent" List="_opponentList" />
                <ol class="steps">
                    <li>
                        Ajoutez votre adversaire sur Steam :
                        <code>@opponent.Player.SteamId</code>
                        · <a href="steam://friends/add/@opponent.Player.SteamId">Ajouter en ami</a>
                        · <a href="https://steamcommunity.com/profiles/@opponent.Player.SteamId" target="_blank" rel="noopener">Profil Steam</a>
                    </li>
                    <li>Lancez Tabletop Simulator avec le mod LCT et invitez-le.</li>
                    <li>Consultez <a href="/lists/@opponent.ArmyListId" target="_blank">sa liste</a> avant de commencer.</li>
                    <li>À la fin de la partie, déclarez le score ci-dessous : votre adversaire le confirmera.</li>
                </ol>

                <div class="result-form">
                    <h3>Déclarer le résultat</h3>
                    <div class="vp-inputs">
                        <label>Mes points de victoire <input type="number" min="0" max="100" @bind="_myVictoryPoints" @bind:event="oninput" /></label>
                        <label>Ses points de victoire <input type="number" min="0" max="100" @bind="_opponentVictoryPoints" @bind:event="oninput" /></label>
                    </div>
                    @if (_myVictoryPoints >= 0 && _opponentVictoryPoints >= 0)
                    {
                        var preview = WtcScore.FromVictoryPoints(_myVictoryPoints, _opponentVictoryPoints);
                        <p>Score WTC : <strong>@preview.Points – @preview.Opponent.Points</strong> · @ResultLabels.Of(preview.Category)</p>
                    }
                    <button class="button" @onclick="DeclareResult" disabled="@(!RendererInfo.IsInteractive)">Déclarer le résultat</button>
                </div>
                break;

            case MatchStatus.ResultDeclared when _match.Declarer == _me:
                <h2>Résultat déclaré</h2>
                <Opponent Ticket="opponent" Player="_opponent" List="_opponentList" />
                <ResultSummary Match="_match" Me="_me" />
                <p>En attente de la confirmation de votre adversaire…</p>
                break;

            case MatchStatus.ResultDeclared:
                <h2>Votre adversaire a déclaré le résultat</h2>
                <Opponent Ticket="opponent" Player="_opponent" List="_opponentList" />
                <ResultSummary Match="_match" Me="_me" />
                <p>Ce score est-il exact ?</p>
                <div class="actions">
                    <button class="button" @onclick="ConfirmResult">Confirmer</button>
                    <button class="button secondary" @onclick="DisputeResult">Contester</button>
                </div>
                <p class="hint">Un résultat contesté ne compte pas pour l'Elo.</p>
                break;
        }

        <button class="button danger abandon" @onclick="Abandon">Abandonner le match</button>
    </section>
}
else
{
    @switch (_status.Activity)
    {
        case PlayerActivity.Idle:
            @if (_lastMatch is not null)
            {
                <section class="card last-match">
                    <h2>Dernier match</h2>
                    <MatchSummaryLine Match="_lastMatch" Me="_me" OpponentName="@_lastOpponentName" />
                    <p><a href="/profile">Voir mon historique</a></p>
                </section>
            }
            @if (_lists.Count == 0)
            {
                <p>Importez d'abord une liste d'armée pour pouvoir chercher un adversaire.</p>
                <p><a href="/lists" class="button">Importer une liste</a></p>
            }
            else
            {
                <section class="card form">
                    <label>
                        Liste
                        <select @bind="_selectedListId">
                            @foreach (var list in _lists)
                            {
                                <option value="@list.Id">@list.Name (@list.Format.Name)</option>
                            }
                        </select>
                    </label>
                    <label class="checkbox">
                        <input type="checkbox" @bind="_ranked" />
                        Partie classée <span class="hint">(compte pour l'Elo ; décochez pour une partie amicale)</span>
                    </label>
                    <button class="button" @onclick="SearchAsync" disabled="@(!RendererInfo.IsInteractive)">Rechercher un adversaire</button>
                </section>
            }
            break;

        case PlayerActivity.Searching:
            <section class="card status searching">
                <h2>Recherche d'un adversaire…</h2>
                <p>@_status.Search!.Format.Name · @(_status.Search.Ranked ? "classée" : "amicale") · depuis @Elapsed(_status.Search.EnqueuedAt)</p>
                <p class="hint">Gardez cet onglet ouvert : vous serez prévenu dès qu'un adversaire est trouvé.</p>
                <button class="button secondary" @onclick="CancelSearch">Annuler la recherche</button>
            </section>
            break;

        case PlayerActivity.MatchProposed:
            <section class="card status proposed">
                <h2>Adversaire trouvé !</h2>
                <Opponent Ticket="_status.Match!.Opponent" Player="_opponent" List="_opponentList" />
                <p>Temps restant pour accepter : <strong>@Remaining(_status.Match.AcceptanceDeadline)</strong></p>
                @if (_status.Match.IAccepted)
                {
                    <p>Vous avez accepté. En attente de votre adversaire…</p>
                }
                else
                {
                    <div class="actions">
                        <button class="button" @onclick="Accept">Accepter</button>
                        <button class="button secondary" @onclick="Decline">Refuser</button>
                    </div>
                }
            </section>
            break;

        case PlayerActivity.InMatch:
            <section class="card status">
                <p>Match accepté, préparation en cours…</p>
            </section>
            break;
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private PlayerId _me;
    private PlayerStatus _status = PlayerStatus.Idle;
    private Match? _match;
    private Match? _lastMatch;
    private string? _lastOpponentName;
    private IReadOnlyList<ArmyList> _lists = [];
    private Guid _selectedListId;
    private bool _ranked = true;
    private int _myVictoryPoints;
    private int _opponentVictoryPoints;
    private string? _error;

    private PlayerId? _opponentLoadedFor;
    private Player? _opponent;
    private ArmyList? _opponentList;

    private Timer? _clock;
    private IJSObjectReference? _notifications;

    protected override async Task OnInitializedAsync()
    {
        _me = SteamAuthentication.PlayerIdOf((await AuthenticationState).User);
        _lists = await UsingServices(services => services.GetRequiredService<ArmyListService>().ListOwnedByAsync(_me));
        _selectedListId = _lists.FirstOrDefault()?.Id ?? Guid.Empty;
        await RefreshAsync();

        if (RendererInfo.IsInteractive)
        {
            Notifier.PlayerChanged += OnPlayerChanged;
            _clock = new Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        }
    }

    private Task SearchAsync() => RunAsync(async () =>
    {
        await RequestNotificationPermissionAsync();
        var (player, list, active) = await UsingServices(async services => (
            await services.GetRequiredService<PlayerAccounts>().FindAsync(_me),
            await services.GetRequiredService<ArmyListService>().FindAsync(_selectedListId),
            await services.GetRequiredService<MatchService>().CanLookForAnotherOpponentAsync(_me)));
        if (!active)
            throw new InvalidOperationException($"Vous avez déjà {MatchService.MaxActiveMatches} parties en cours.");
        if (player is null || list is null)
            throw new InvalidOperationException("Liste introuvable.");

        Coordinator.Search(player, list, _ranked);
    });

    private Task CancelSearch() => RunAsync(() => Coordinator.CancelSearch(_me));

    private Task Decline() => RunAsync(() => Coordinator.Decline(_me, _status.Match!.Id));

    private Task Accept() => RunAsync(async () =>
    {
        var accepted = Coordinator.Accept(_me, _status.Match!.Id);
        if (accepted is null) return;

        await UsingServices(services => services.GetRequiredService<MatchService>().StartAsync(accepted));
        Coordinator.Release(accepted.Id);
    });

    private Task DeclareResult() => UpdateMatch(matches =>
        matches.DeclareResultAsync(_me, _match!.Id, _myVictoryPoints, _opponentVictoryPoints));

    private Task ConfirmResult() => UpdateMatch(matches => matches.ConfirmResultAsync(_me, _match!.Id));

    private Task DisputeResult() => UpdateMatch(matches => matches.DisputeResultAsync(_me, _match!.Id));

    private Task Abandon() => UpdateMatch(matches => matches.AbandonAsync(_me, _match!.Id));

    private Task UpdateMatch(Func<MatchService, Task<Match>> change) => RunAsync(async () =>
    {
        var match = await UsingServices(services => change(services.GetRequiredService<MatchService>()));
        Notifier.Notify([match.First.Player, match.Second.Player]);
    });

    private Task RunAsync(Action action) => RunAsync(() => { action(); return Task.CompletedTask; });

    private async Task RunAsync(Func<Task> action)
    {
        _error = null;
        try
        {
            await action();
        }
        catch (Exception e) when (e is InvalidOperationException or ArgumentException)
        {
            _error = e.Message;
        }
        await RefreshAsync();
    }

    private void OnPlayerChanged(PlayerId player)
    {
        if (player != _me) return;

        _ = InvokeAsync(async () =>
        {
            var before = _status.Activity;
            await RefreshAsync();
            if (before != PlayerActivity.MatchProposed && _status.Activity == PlayerActivity.MatchProposed)
                await NotifyMatchFoundAsync();
            StateHasChanged();
        });
    }

    private async Task RefreshAsync()
    {
        (_match, _lastMatch, _lastOpponentName) = await UsingServices(async services =>
        {
            var matches = services.GetRequiredService<MatchService>();
            var last = (await matches.HistoryOfAsync(_me, limit: 1)).FirstOrDefault();
            var lastOpponent = last is null ? null : await services.GetRequiredService<PlayerAccounts>().FindAsync(last.OpponentOf(_me).Player);
            return ((await matches.ActiveMatchesOfAsync(_me)).FirstOrDefault(), last, lastOpponent?.DisplayName);
        });
        _status = Coordinator.StatusOf(_me);

        var opponent = _match?.OpponentOf(_me) ?? _status.Match?.Opponent;
        if (opponent is null || opponent.Player == _opponentLoadedFor) return;

        (_opponent, _opponentList) = await UsingServices(async services => (
            await services.GetRequiredService<PlayerAccounts>().FindAsync(opponent.Player),
            await services.GetRequiredService<ArmyListService>().FindAsync(opponent.ArmyListId)));
        _opponentLoadedFor = opponent.Player;
    }

    private async Task RequestNotificationPermissionAsync()
    {
        try
        {
            _notifications ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/notifications.js");
            await _notifications.InvokeVoidAsync("requestPermission");
        }
        catch (JSException)
        {
            // Pas de notification système : la page se met quand même à jour.
        }
    }

    private async Task NotifyMatchFoundAsync()
    {
        try
        {
            _notifications ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/notifications.js");
            await _notifications.InvokeVoidAsync("notifyMatchFound", _opponent?.DisplayName ?? "Votre adversaire");
        }
        catch (JSException)
        {
        }
    }

    // Composant interactif de longue durée : un scope (et donc un DbContext) par opération.
    private async Task<T> UsingServices<T>(Func<IServiceProvider, Task<T>> work)
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        return await work(scope.ServiceProvider);
    }

    private async Task UsingServices(Func<IServiceProvider, Task> work)
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        await work(scope.ServiceProvider);
    }

    private string Elapsed(DateTimeOffset since) => Format(Time.GetUtcNow() - since);

    private string Remaining(DateTimeOffset deadline) => Format(deadline - Time.GetUtcNow());

    private static string Format(TimeSpan duration) =>
        duration <= TimeSpan.Zero ? "0:00" : $"{(int)duration.TotalMinutes}:{duration.Seconds:00}";

    public async ValueTask DisposeAsync()
    {
        Notifier.PlayerChanged -= OnPlayerChanged;
        if (_clock is not null) await _clock.DisposeAsync();
        if (_notifications is not null)
        {
            try { await _notifications.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
