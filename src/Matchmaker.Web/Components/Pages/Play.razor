@page "/play"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@using Matchmaker.Domain.ArmyLists
@using Matchmaker.Domain.Matches
@using Matchmaker.Domain.Players
@using Matchmaker.Web.Accounts
@using Matchmaker.Web.ArmyLists
@using Matchmaker.Web.Matches
@using Matchmaker.Web.Matchmaking
@using Microsoft.EntityFrameworkCore
@inject MatchmakingCoordinator Coordinator
@inject PlayerNotifier Notifier
@inject IServiceScopeFactory ScopeFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject TimeProvider Time

<PageTitle>Rechercher une partie</PageTitle>

<h1><Icon Name="search" /> Rechercher une partie</h1>

@if (_activeMatches.Count > 0)
{
    <p class="hint">
        Vous avez @_activeMatches.Count @(_activeMatches.Count > 1 ? "parties" : "partie") en cours ·
        <a href="/matches"><Icon Name="matches" /> Mes parties</a>
    </p>
}

@if (_error is not null)
{
    <p class="error" role="alert">@_error</p>
}

@switch (_status.Activity)
{
    case PlayerActivity.Idle when _activeMatches.Count >= MatchService.MaxActiveMatches:
        <p class="card">Vous avez déjà @MatchService.MaxActiveMatches parties en cours. Terminez une partie pour chercher un nouvel adversaire.</p>
        break;

    case PlayerActivity.Idle when _lists.Count == 0:
        <p>Importez d'abord une liste d'armée pour pouvoir chercher un adversaire.</p>
        <p><a href="/lists?import=1" class="button"><Icon Name="import" /> Importer une liste</a></p>
        break;

    case PlayerActivity.Idle:
        <NewGameForm Lists="_lists" Opponents="_opponents" Opponent="OpponentGiven" OnSearch="SearchAsync" OnPlan="PlanAsync" />
        break;

    case PlayerActivity.Searching:
        <section class="card status searching">
            <h2>Recherche d'un adversaire…</h2>
            <p>@GameFormats.LabelOf(_status.Search!.Format) · @(_status.Search.Ranked ? "classée" : "amicale") · depuis @Elapsed(_status.Search.EnqueuedAt)</p>
            @if (_status.Search.ReservedFor is { } reservedFor && _opponents.FirstOrDefault(p => p.Id == reservedFor) is { } opponent)
            {
                <p>Partie proposée uniquement à <PlayerLink Player="opponent" />.</p>
            }
            <p class="hint">Gardez cet onglet ouvert : vous serez prévenu dès qu'un adversaire est trouvé.</p>
            <button class="button secondary" @onclick="CancelSearch"><Icon Name="close" /> Annuler la recherche</button>
        </section>
        break;

    case PlayerActivity.MatchProposed:
        <section class="card status proposed">
            <h2>Adversaire trouvé !</h2>
            <Opponent Ticket="_status.Match!.Opponent" Player="_proposedOpponent" List="ListLink.To(_proposedOpponentList)" />
            <p>Temps restant pour accepter : <strong>@Remaining(_status.Match.AcceptanceDeadline)</strong></p>
            @if (_status.Match.IAccepted)
            {
                <p>Vous avez accepté. En attente de votre adversaire…</p>
            }
            else
            {
                <div class="actions">
                    <button class="button" @onclick="Accept"><Icon Name="check" /> Accepter</button>
                    <button class="button secondary" @onclick="Decline"><Icon Name="close" /> Refuser</button>
                </div>
            }
        </section>
        break;

    case PlayerActivity.InMatch:
        <section class="card status">
            <p>Match accepté, préparation en cours…</p>
        </section>
        break;
}

@if (_proposedToMe.Count > 0)
{
    <section class="proposed-to-me">
        <h2><Icon Name="swords" /> Parties qu'on vous propose</h2>
        @foreach (var search in _proposedToMe)
        {
            <div @key="search" class="card status proposed">
                <h3>
                    @if (search.PlannedFor is { } plannedFor)
                    {
                        <text>Partie proposée pour le <LocalTime Value="plannedFor" /></text>
                    }
                    else
                    {
                        <text>Partie proposée maintenant</text>
                    }
                </h3>
                <Opponent Ticket="search.Ticket" Player="_proposedToMePlayers.GetValueOrDefault(search.Ticket.Player)" List="ListLink.To(_proposedToMeLists.GetValueOrDefault(search.Ticket.ArmyListId))" />
                <div class="actions">
                    @if (ListsFor(search.Ticket.Format) is { Count: > 0 } lists)
                    {
                        <JoinSearchForm Lists="lists" Icon="check" Label="Jouer cette partie" OnJoin="listId => JoinProposedAsync(search, listId)" />
                    }
                    else
                    {
                        <a href="/lists?import=1" class="button secondary"><Icon Name="import" /> Importer une liste @GameFormats.LabelOf(search.Ticket.Format)</a>
                    }
                    <button class="button secondary" @onclick="() => DeclineProposedAsync(search)" disabled="@(!RendererInfo.IsInteractive)"><Icon Name="close" /> Refuser</button>
                </div>
            </div>
        }
    </section>
}

<ScheduledGamesList Overview="_scheduled" Me="_me" Players="_scheduledPlayers" Lists="_scheduledLists"
                    OnAccept="AcceptPlannedAsync" OnDecline="DeclinePlannedAsync" OnCancel="CancelPlannedAsync" />

@if (_confirmedPlanned)
{
    <p class="card status in-match">Partie planifiée confirmée ! Retrouvez-la dans <a href="/matches">Mes parties</a>.</p>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;
    /// <summary>Steam ID de l'adversaire à présélectionner (ex. depuis son profil).</summary>
    [SupplyParameterFromQuery(Name = "opponent")] public string? OpponentSteamId { get; set; }

    private PlayerId _me;
    private PlayerStatus _status = PlayerStatus.Idle;
    private IReadOnlyList<Match> _activeMatches = [];
    private IReadOnlyList<ArmyList> _lists = [];
    private IReadOnlyList<Player> _opponents = [];
    private IReadOnlyList<OpenSearch> _proposedToMe = [];
    private IReadOnlyDictionary<PlayerId, Player> _proposedToMePlayers = new Dictionary<PlayerId, Player>();
    private IReadOnlyDictionary<Guid, ArmyList> _proposedToMeLists = new Dictionary<Guid, ArmyList>();
    private TimeZoneInfo _timeZone = TimeZoneInfo.Utc;
    private bool _confirmedPlanned;
    private ScheduledOverview _scheduled = new([], []);
    private IReadOnlyDictionary<PlayerId, Player> _scheduledPlayers = new Dictionary<PlayerId, Player>();
    private Dictionary<Guid, ArmyList> _scheduledLists = [];
    private string? _error;
    private bool _startingSearch;

    private Guid? _proposalLoadedFor;
    private Player? _proposedOpponent;
    private ArmyList? _proposedOpponentList;

    private Timer? _clock;
    private IJSObjectReference? _notifications;

    protected override async Task OnInitializedAsync()
    {
        _me = SteamAuthentication.PlayerIdOf((await AuthenticationState).User);
        _lists = await ScopeFactory.UsingScopeAsync(services => services.GetRequiredService<ArmyListService>().ListOwnedByAsync(_me));
        _opponents = await ScopeFactory.UsingScopeAsync(services => services.GetRequiredService<PlayerAccounts>().OthersThanAsync(_me));
        await RefreshAsync();

        if (RendererInfo.IsInteractive)
        {
            Notifier.PlayerChanged += OnPlayerChanged;
            _clock = new Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        }
    }

    private async Task SearchAsync(NewGameForm.Request request)
    {
        if (_startingSearch) return;

        _startingSearch = true;
        await RunAsync(() => ScopeFactory.UsingScopeAsync(services => services.GetRequiredService<GameSearches>().SearchNowAsync(_me, request.ListId, request.Ranked, request.Opponent)));
        _startingSearch = false;

        // Surtout pas avant la recherche, ni en l'attendant : le joueur peut laisser la question du navigateur sans réponse,
        // et un clic resté en attente relancerait une recherche après son annulation.
        if (_error is null) _ = RequestNotificationPermissionAsync();
    }

    private Task CancelSearch() => RunAsync(() => Coordinator.CancelSearch(_me));

    private Task PlanAsync(NewGameForm.Request request) => RunAsync(async () =>
    {
        var local = DateTime.SpecifyKind(request.PlannedLocal!.Value, DateTimeKind.Unspecified);
        var plannedFor = new DateTimeOffset(local, _timeZone.GetUtcOffset(local));
        if (plannedFor < Time.GetUtcNow() + Match.ScheduledAcceptanceNotice)
            throw new InvalidOperationException("Choisissez une heure au moins 1 h à l'avance.");
        await ScopeFactory.UsingScopeAsync(services => services.GetRequiredService<ScheduledGames>().PlanAsync(_me, request.ListId, request.Ranked, plannedFor, request.Opponent));
    });

    private Task JoinProposedAsync(OpenSearch search, Guid listId) =>
        RunAsync(() => ScopeFactory.UsingScopeAsync(services => services.GetRequiredService<GameSearches>().JoinAsync(_me, listId, search)));

    private Task DeclineProposedAsync(OpenSearch search) =>
        RunAsync(() => ScopeFactory.UsingScopeAsync(services => services.GetRequiredService<GameSearches>().DeclineAsync(_me, search)));

    private Task CancelPlannedAsync(Guid searchId) =>
        RunAsync(() => ScopeFactory.UsingScopeAsync(services => services.GetRequiredService<ScheduledGames>().CancelAsync(_me, searchId)));

    private Task DeclinePlannedAsync(Guid matchId) =>
        RunAsync(() => ScopeFactory.UsingScopeAsync(services => services.GetRequiredService<ScheduledGames>().DeclineAsync(_me, matchId)));

    private Task AcceptPlannedAsync(Guid matchId) => RunAsync(async () =>
    {
        var match = await ScopeFactory.UsingScopeAsync(services => services.GetRequiredService<ScheduledGames>().AcceptAsync(_me, matchId));
        _confirmedPlanned = match.Status == MatchStatus.Accepted;
    });

    private Task Decline() => RunAsync(() => Coordinator.Decline(_me, _status.Match!.Id));

    private Task Accept() => RunAsync(async () =>
    {
        var accepted = Coordinator.Accept(_me, _status.Match!.Id);
        if (accepted is null) return;

        await ScopeFactory.UsingScopeAsync(services => services.GetRequiredService<MatchService>().StartAsync(accepted));
        Coordinator.Release(accepted.Id);
        Navigation.NavigateTo($"/matches/{accepted.Id}");
    });

    private Task RunAsync(Action action) => RunAsync(() => { action(); return Task.CompletedTask; });

    private async Task RunAsync(Func<Task> action)
    {
        _error = null;
        try
        {
            await action();
        }
        catch (Exception e) when (e is InvalidOperationException or ArgumentException)
        {
            _error = e.Message;
        }
        catch (DbUpdateConcurrencyException)
        {
            _error = MatchService.ConcurrentChangeMessage;
        }
        await RefreshAsync();
    }

    private void OnPlayerChanged(PlayerId player)
    {
        if (player != _me) return;

        _ = InvokeAsync(async () =>
        {
            var before = _status.Activity;
            await RefreshAsync();
            if (before != PlayerActivity.MatchProposed && _status.Activity == PlayerActivity.MatchProposed)
                await NotifyMatchFoundAsync();
            StateHasChanged();
        });
    }

    private async Task RefreshAsync()
    {
        _activeMatches = await ScopeFactory.UsingScopeAsync(services => services.GetRequiredService<MatchService>().ActiveMatchesOfAsync(_me));
        _status = Coordinator.StatusOf(_me);
        await RefreshScheduledAsync();
        await RefreshProposedToMeAsync();

        var proposal = _status.Match;
        if (proposal is null || proposal.Id == _proposalLoadedFor) return;

        (_proposedOpponent, _proposedOpponentList) = await ScopeFactory.UsingScopeAsync(async services => (
            await services.GetRequiredService<PlayerAccounts>().FindAsync(proposal.Opponent.Player),
            await services.GetRequiredService<ArmyListService>().FindAsync(proposal.Opponent.ArmyListId)));
        _proposalLoadedFor = proposal.Id;
    }

    private async Task RefreshProposedToMeAsync()
    {
        (_proposedToMe, _proposedToMePlayers, _proposedToMeLists) = await ScopeFactory.UsingScopeAsync(async services =>
        {
            var searches = await services.GetRequiredService<GameSearches>().ProposedToAsync(_me);
            return (searches,
                await services.GetRequiredService<PlayerAccounts>().FindManyAsync(searches.Select(s => s.Ticket.Player)),
                await services.GetRequiredService<ArmyListService>().FindManyAsync(searches.Select(s => s.Ticket.ArmyListId)));
        });
    }

    private IReadOnlyList<ArmyList> ListsFor(GameFormat format) =>
        [.. ArmyList.FavoriteFirstThenByName(_lists).Where(l => l.IsCompatibleWith(format))];

    private PlayerId? OpponentGiven => string.IsNullOrEmpty(OpponentSteamId) ? null : new PlayerId(OpponentSteamId);

    private async Task RefreshScheduledAsync()
    {
        _scheduled = await ScopeFactory.UsingScopeAsync(services => services.GetRequiredService<ScheduledGames>().OverviewAsync(_me));
        var opponents = _scheduled.Proposals.Select(m => m.OpponentOf(_me)).ToList();
        var reservedFor = _scheduled.OpenSearches.Select(s => s.Ticket.ReservedFor).OfType<PlayerId>();
        (_scheduledPlayers, _scheduledLists) = await ScopeFactory.UsingScopeAsync(async services =>
        {
            var lists = new Dictionary<Guid, ArmyList>();
            foreach (var opponent in opponents)
                if (await services.GetRequiredService<ArmyListService>().FindAsync(opponent.ArmyListId) is { } list)
                    lists[list.Id] = list;
            return (await services.GetRequiredService<PlayerAccounts>().FindManyAsync(opponents.Select(o => o.Player).Concat(reservedFor)), lists);
        });
    }

    // L'heure saisie est celle du joueur : on lit le fuseau de son navigateur.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var zone = await JS.InvokeAsync<string>("matchmakerTimeZone");
            _timeZone = TimeZoneInfo.FindSystemTimeZoneById(zone);
        }
        catch (Exception e) when (e is JSException or TimeZoneNotFoundException or InvalidTimeZoneException)
        {
            // Fuseau inconnu : l'heure est comprise en UTC, et affichée comme telle après coup.
        }
    }

    private async Task RequestNotificationPermissionAsync()
    {
        try
        {
            _notifications ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/notifications.js");
            await _notifications.InvokeVoidAsync("requestPermission");
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or OperationCanceledException)
        {
            // Pas de notification système, question sans réponse ou page quittée : la page se met quand même à jour.
        }
    }

    private async Task NotifyMatchFoundAsync()
    {
        try
        {
            _notifications ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/notifications.js");
            await _notifications.InvokeVoidAsync("notifyMatchFound", _proposedOpponent?.DisplayName ?? "Votre adversaire");
        }
        catch (JSException)
        {
        }
    }

    private string Elapsed(DateTimeOffset since) => Format(Time.GetUtcNow() - since);

    private string Remaining(DateTimeOffset deadline) => Format(deadline - Time.GetUtcNow());

    private static string Format(TimeSpan duration) =>
        duration <= TimeSpan.Zero ? "0:00" : $"{(int)duration.TotalMinutes}:{duration.Seconds:00}";

    public async ValueTask DisposeAsync()
    {
        Notifier.PlayerChanged -= OnPlayerChanged;
        if (_clock is not null) await _clock.DisposeAsync();
        if (_notifications is not null)
        {
            try { await _notifications.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
