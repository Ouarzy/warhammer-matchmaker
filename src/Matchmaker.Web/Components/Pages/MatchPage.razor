@page "/matches/{Id:guid}"
@rendermode InteractiveServer
@implements IDisposable
@using Matchmaker.Domain.Matches
@using Matchmaker.Domain.Players
@using Matchmaker.Web.Accounts
@using Matchmaker.Web.Matches
@using Matchmaker.Web.Matchmaking
@using Microsoft.EntityFrameworkCore
@using Matchmaker.Web.Tts
@inject PlayerNotifier Notifier
@inject IServiceScopeFactory ScopeFactory
@inject NavigationManager Navigation
@inject TimeProvider Time
@inject IConfiguration Configuration
@inject LiveScores LiveScores

<PageTitle>Partie</PageTitle>

@if (_match is not null)
{
    <MatchSheet Match="_match" Players="_players" Archives="_archives" />

    @if (_match.Status == MatchStatus.Accepted && LiveScores.Of(Id) is { } live)
    {
        <section class="card live-score" aria-live="polite">
            <h2><Icon Name="swords" /> Score en direct</h2>
            <p class="live-value">@NameOf(_match.First.Player) @live.FirstVictoryPoints – @live.SecondVictoryPoints @NameOf(_match.Second.Player)</p>
            <p class="hint">Lu sur la feuille de score LCT, round @live.RoundsPlayed · mis à jour @Ago(live.At). Le résultat reste à déclarer en fin de partie.</p>
        </section>
    }

    @if (_error is not null)
    {
        <p class="error" role="alert">@_error</p>
    }

    @if (_me is { } me && _match.Status is MatchStatus.Accepted or MatchStatus.ResultDeclared)
    {
        var opponent = _match.OpponentOf(me);
        var opponentName = _players.GetValueOrDefault(opponent.Player)?.DisplayName ?? "votre adversaire";
        <section class="card status in-match">
            @switch (_match.Status)
            {
                case MatchStatus.Accepted:
                    <h2><Icon Name="swords" /> À vous de jouer</h2>
                    <ol class="steps">
                        <li>
                            Ajoutez @opponentName sur Steam :
                            <code>@opponent.Player.SteamId</code>
                            · <a href="steam://friends/add/@opponent.Player.SteamId"><Icon Name="friend" /> Ajouter en ami</a>
                            · <a href="https://steamcommunity.com/profiles/@opponent.Player.SteamId" target="_blank" rel="noopener"><Icon Name="external" /> Profil Steam</a>
                        </li>
                        <li>Lancez Tabletop Simulator avec le mod LCT et invitez-le. La partie peut se jouer en plusieurs fois.</li>
                        <li>Consultez sa liste ci-dessus avant de commencer.</li>
                        <li>À la fin de la partie, l'un de vous déclare le score, depuis l'objet TTS ou à la main ci-dessous, et l'autre le confirme.</li>
                    </ol>

                    @if (_reportCode is not null)
                    {
                        <TtsReportCode Code="@_reportCode" />
                    }

                    <ScoreForm Title="Déclarer le résultat" SubmitLabel="Déclarer le résultat" OnSubmit="DeclareResult" />
                    break;

                case MatchStatus.ResultDeclared when _match.Declarer == me:
                    <h2>@(_match.Contestations == 0 ? "Résultat déclaré" : "Vous avez proposé un autre score")</h2>
                    <ResultSummary Match="_match" Me="me" />
                    <p>En attente de la réponse de votre adversaire : il peut confirmer ce score ou en proposer un autre.</p>
                    <p class="hint">Sans réponse de sa part, le résultat sera confirmé automatiquement dans @Remaining(_match.ResultConfirmationDeadline!.Value).</p>
                    break;

                case MatchStatus.ResultDeclared:
                    <h2>@(_match.Contestations == 0 ? "Votre adversaire a déclaré le résultat" : "Votre adversaire conteste et propose un autre score")</h2>
                    <ResultSummary Match="_match" Me="me" />
                    @if (_contesting)
                    {
                        @* Le formulaire part du score proposé, à corriger. *@
                        <ScoreForm Title="Proposer le bon score" SubmitLabel="Proposer ce score"
                                   InitialMine="_match.VictoryPointsOf(me)" InitialTheirs="_match.VictoryPointsOf(opponent.Player)"
                                   OnSubmit="ContestResult" OnCancel="() => _contesting = false"
                                   Hint="Votre adversaire pourra l'accepter ou le contester à son tour." />
                    }
                    else
                    {
                        <p>Ce score est-il exact ?</p>
                        <div class="actions">
                            <button class="button" @onclick="ConfirmResult"><Icon Name="check" /> Confirmer</button>
                            <button class="button secondary" @onclick="() => _contesting = true" disabled="@(!RendererInfo.IsInteractive)"><Icon Name="edit" /> Contester et proposer un autre score</button>
                        </div>
                    }
                    <p class="hint">
                        Sans réponse de votre part, ce score sera confirmé automatiquement dans @Remaining(_match.ResultConfirmationDeadline!.Value).
                    </p>
                    break;
            }

            <div class="abandon">
                @if (_confirmingAbandon)
                {
                    <p><strong>Abandonner donne la victoire 20-0 à @opponentName@(_match.First.Ranked ? " et compte pour l'Elo" : "").</strong></p>
                    <div class="actions">
                        <button class="button danger" @onclick="Abandon"><Icon Name="flag" /> Confirmer l'abandon</button>
                        <button class="button secondary" @onclick="() => _confirmingAbandon = false">Annuler</button>
                    </div>
                }
                else
                {
                    <button class="button danger" @onclick="() => _confirmingAbandon = true" disabled="@(!RendererInfo.IsInteractive)"><Icon Name="flag" /> Abandonner la partie</button>
                }
            </div>
        </section>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    /// <summary>Le joueur connecté, s'il participe à ce match ; null pour un spectateur.</summary>
    private PlayerId? _me;
    private Match? _match;
    private IReadOnlyDictionary<PlayerId, Player> _players = new Dictionary<PlayerId, Player>();
    private ArchivedLists _archives = ArchivedLists.None;
    private string? _reportCode;
    private bool _contesting;
    private bool _confirmingAbandon;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        if (_match is null)
        {
            Navigation.NotFound();
            return;
        }

        var user = (await AuthenticationState).User;
        if (user.Identity?.IsAuthenticated == true)
        {
            var player = SteamAuthentication.PlayerIdOf(user);
            if (player == _match.First.Player || player == _match.Second.Player)
                _me = player;
        }

        // Envoi du score depuis TTS : affiché seulement une fois la fonction ouverte (Tts:Enabled).
        if (_me is not null && Configuration.GetValue<bool>("Tts:Enabled"))
            _reportCode = await ScopeFactory.UsingScopeAsync(services => services.GetRequiredService<TtsReporting>().CodeOfAsync(Id));

        (_players, _archives) = await ScopeFactory.UsingScopeAsync(async services => (
            await services.GetRequiredService<PlayerAccounts>().FindManyAsync([_match.First.Player, _match.Second.Player]),
            await services.GetRequiredService<MatchService>().ArchivedListsOfAsync([Id])));

        if (RendererInfo.IsInteractive)
            Notifier.PlayerChanged += OnPlayerChanged;
    }

    private Task DeclareResult((int Mine, int Theirs) score) =>
        Update((matches, me) => matches.DeclareResultAsync(me, Id, score.Mine, score.Theirs));
    private Task ConfirmResult() => Update((matches, me) => matches.ConfirmResultAsync(me, Id));
    private Task ContestResult((int Mine, int Theirs) score) =>
        Update((matches, me) => matches.ContestResultAsync(me, Id, score.Mine, score.Theirs));
    private Task Abandon() => Update((matches, me) => matches.AbandonAsync(me, Id));

    private async Task Update(Func<MatchService, PlayerId, Task<Match>> change)
    {
        if (_me is not { } me) return;

        _error = null;
        _confirmingAbandon = false;
        try
        {
            var match = await ScopeFactory.UsingScopeAsync(services => change(services.GetRequiredService<MatchService>(), me));
            _contesting = false;
            Notifier.Notify([match.First.Player, match.Second.Player]);
        }
        catch (Exception e) when (e is InvalidOperationException or ArgumentException)
        {
            _error = e.Message;
        }
        catch (DbUpdateConcurrencyException)
        {
            _error = MatchService.ConcurrentChangeMessage;
        }
        await RefreshAsync();
    }

    // Joueurs comme spectateurs suivent la partie en direct.
    private void OnPlayerChanged(PlayerId player)
    {
        if (_match is null || (player != _match.First.Player && player != _match.Second.Player)) return;
        _ = InvokeAsync(async () =>
        {
            await RefreshAsync();
            StateHasChanged();
        });
    }

    private string NameOf(PlayerId player) => _players.GetValueOrDefault(player)?.DisplayName ?? "Joueur";

    private async Task RefreshAsync() =>
        _match = await ScopeFactory.UsingScopeAsync(services => services.GetRequiredService<MatchService>().FindAsync(Id));

    private string Remaining(DateTimeOffset deadline)
    {
        var left = deadline - Time.GetUtcNow();
        if (left <= TimeSpan.Zero) return "quelques instants";
        return left.TotalHours >= 1 ? $"{(int)left.TotalHours} h {left.Minutes:00}" : $"{left.Minutes} min";
    }

    private string Ago(DateTimeOffset at)
    {
        var elapsed = Time.GetUtcNow() - at;
        return elapsed.TotalMinutes < 1 ? "à l'instant" : elapsed.TotalHours >= 1 ? $"il y a {(int)elapsed.TotalHours} h" : $"il y a {(int)elapsed.TotalMinutes} min";
    }

    public void Dispose() => Notifier.PlayerChanged -= OnPlayerChanged;
}
