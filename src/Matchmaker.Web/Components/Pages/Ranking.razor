@page "/ranking"
@using Matchmaker.Domain.Players
@using Matchmaker.Web.Accounts
@using Matchmaker.Web.Matches
@inject MatchService Matches

<PageMeta Title="Classement" Description="Classement Elo des joueurs de Warhammer 40 000 sur Tabletop Simulator, mis à jour après chaque partie classée." Path="/ranking" />

<h1><Icon Name="trophy" /> Classement</h1>

<p class="hint">Classement Elo des joueurs ayant disputé au moins une partie classée.</p>

@if (_ranking.Count == 0)
{
    <p>Aucune partie classée n'a encore été jouée. Soyez le premier !</p>
}
else
{
    <div class="table-scroll">
        <table class="ranking">
            <thead>
                <tr><th>#</th><th>Joueur</th><th>Elo</th><th>Parties classées</th></tr>
            </thead>
            <tbody>
                @for (var i = 0; i < _ranking.Count; i++)
                {
                    var player = _ranking[i];
                    <tr class="@(player.Id == _me ? "me" : null)">
                        <td>@(i + 1)</td>
                        <td><PlayerLink Player="player" /></td>
                        <td><strong>@player.Rating.Value</strong></td>
                        <td>@player.RankedGamesPlayed</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private IReadOnlyList<Player> _ranking = [];
    private PlayerId? _me;

    protected override async Task OnInitializedAsync()
    {
        _ranking = await Matches.RankingAsync();
        var user = (await AuthenticationState).User;
        if (user.Identity?.IsAuthenticated == true)
            _me = SteamAuthentication.PlayerIdOf(user);
    }
}
