@inherits LayoutComponentBase

<header class="topbar">
    <AuthorizeView>
        <Authorized>
            @* Téléphone : ouvre le menu latéral (case à cocher, fonctionne sans JavaScript). *@
            <label class="burger" for="menu-toggle" aria-label="Menu"><Icon Name="menu" /></label>
        </Authorized>
    </AuthorizeView>
    <a href="/" class="brand"><Icon Name="swords" /> Warhammer Matchmaker</a>
    <AuthorizeView>
        <NotAuthorized>
            <nav class="public-links">
                <NavLink href="/live"><Icon Name="swords" /> Parties en cours</NavLink>
                <NavLink href="/ranking"><Icon Name="trophy" /> Classement</NavLink>
                <NavLink href="/players"><Icon Name="players" /> Joueurs</NavLink>
                <a href="/login" class="button"><Icon Name="login" /> Se connecter avec Steam</a>
            </nav>
        </NotAuthorized>
    </AuthorizeView>
</header>

<AuthorizeView>
    <Authorized>
        <input type="checkbox" id="menu-toggle" class="menu-toggle" aria-hidden="true" tabindex="-1" />
        <label class="menu-backdrop" for="menu-toggle" aria-hidden="true"></label>
        <div class="shell">
            <nav class="sidebar" aria-label="Menu principal">
                <p class="sidebar-user"><Icon Name="account" /> @context.User.Identity?.Name</p>
                <NavLink href="/profile"><Icon Name="account" /> Mon compte</NavLink>
                <NavLink href="/play" class="primary"><Icon Name="search" /> Rechercher une partie <ProposalsBadge /></NavLink>
                <NavLink href="/matches" Match="NavLinkMatch.All"><Icon Name="matches" /> Mes parties</NavLink>
                <NavLink href="/lists" Match="NavLinkMatch.All"><Icon Name="lists" /> Mes listes</NavLink>
                <hr />
                <NavLink href="/live"><Icon Name="swords" /> Parties en cours</NavLink>
                <NavLink href="/ranking"><Icon Name="trophy" /> Classement</NavLink>
                <NavLink href="/players" Match="NavLinkMatch.All"><Icon Name="players" /> Joueurs</NavLink>
                <hr />
                <NavLink href="/me-soutenir"><Icon Name="heart" /> Me soutenir</NavLink>
                <form method="post" action="/logout">
                    <AntiforgeryToken />
                    <button type="submit" class="sidebar-link"><Icon Name="logout" /> Se déconnecter</button>
                </form>
            </nav>
            <div class="content">
                <main>@Body</main>
                <SiteFooter />
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <main>@Body</main>
        <SiteFooter />
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    Une erreur inattendue est survenue.
    <a href="." class="reload">Recharger</a>
    <span class="dismiss">🗙</span>
</div>
