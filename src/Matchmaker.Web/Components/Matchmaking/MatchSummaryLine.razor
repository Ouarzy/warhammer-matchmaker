@using Matchmaker.Domain.Matches
@using Matchmaker.Domain.Players

@{
    var opponent = Match.OpponentOf(Me);
    var opponentName = OpponentName ?? opponent.Player.SteamId;
}
@* Toute la ligne mène à l'écran de la partie (joueurs, listes, score). *@
<a class="match-line" href="/matches/@Match.Id">
    <span>@Match.ProposedAt.ToString("dd/MM/yyyy") · @Match.First.Format.Name · @(Match.First.Ranked ? "classée" : "amicale")</span>
    <span>contre @opponentName</span>
    @if (Match.Status is MatchStatus.Completed or MatchStatus.Abandoned)
    {
        var score = Match.ScoreOf(Me);
        <span>
            <strong>@ResultLabels.Of(score.Category)</strong>
            @if (Match.Status == MatchStatus.Abandoned)
            {
                @($" (WTC {score.Points} – {score.Opponent.Points}, {(Match.AbandonedBy == Me ? "abandon" : $"abandon de {opponentName}")})")
            }
            else
            {
                @($" ({Match.VictoryPointsOf(Me)} – {Match.VictoryPointsOf(opponent.Player)}, WTC {score.Points} – {score.Opponent.Points}{(Match.ConfirmedAutomatically ? ", confirmé automatiquement" : "")})")
            }
        </span>
        @if (Match.RatingChangeOf(Me) is { } change)
        {
            <span class="@(change >= 0 ? "gain" : "loss")">Elo @ResultLabels.Signed(change)</span>
        }
    }
    else
    {
        <span class="hint">@ResultLabels.Of(Match.Status) · sans effet sur l'Elo</span>
    }
</a>

@code {
    [Parameter, EditorRequired] public Match Match { get; set; } = default!;
    [Parameter, EditorRequired] public PlayerId Me { get; set; }
    [Parameter] public string? OpponentName { get; set; }
}
