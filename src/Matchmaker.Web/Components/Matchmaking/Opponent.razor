@using Matchmaker.Domain.ArmyLists
@using Matchmaker.Domain.Matchmaking
@using Matchmaker.Domain.Players

<div class="opponent">
    @if (Player?.AvatarUrl is not null)
    {
        <img src="@Player.AvatarUrl" alt="" width="64" height="64" />
    }
    <div>
        <p class="opponent-name">@(Player?.DisplayName ?? Ticket.Player.SteamId)</p>
        <p>
            Elo @(Player?.Rating.Value ?? Ticket.Rating.Value)
            · @(List?.Faction ?? "Faction inconnue")
            · @Ticket.Format.Name
            · @(Ticket.Ranked ? "classée" : "amicale")
        </p>
        @if (List is not null)
        {
            <p><a href="/lists/@List.Id" target="_blank">Voir sa liste « @List.Name »</a></p>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public QueueTicket Ticket { get; set; } = default!;
    [Parameter] public Player? Player { get; set; }
    [Parameter] public ArmyList? List { get; set; }
}
