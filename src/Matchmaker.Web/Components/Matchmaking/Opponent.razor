@using Matchmaker.Domain.Matchmaking
@using Matchmaker.Domain.Players

<div class="opponent">
    @if (Player?.AvatarUrl is not null)
    {
        <img src="@Player.AvatarUrl" alt="" width="64" height="64" />
    }
    <div>
        <p class="opponent-name">
            @if (Player is not null)
            {
                <a href="/players/@Player.Id.SteamId" target="_blank">@Player.DisplayName</a>
            }
            else
            {
                @Ticket.Player.SteamId
            }
        </p>
        <p>
            Elo @(Player?.Rating.Value ?? Ticket.Rating.Value)
            · @(List?.Faction ?? "Faction inconnue")
            @if (List?.Detachment is { } detachment)
            {
                @($" · {detachment}")
            }
            · @Ticket.Format.Name
            · @(Ticket.Ranked ? "classée" : "amicale")
        </p>
        @if (List is not null)
        {
            <p><a href="@List.Url" target="_blank"><Icon Name="eye" /> Voir sa liste « @List.Name »</a></p>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public QueueTicket Ticket { get; set; } = default!;
    [Parameter] public Player? Player { get; set; }
    [Parameter] public ListLink? List { get; set; }
}
