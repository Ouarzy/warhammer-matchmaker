@using Matchmaker.Domain.Matches
@using Matchmaker.Domain.Matchmaking
@using Matchmaker.Domain.Players
@using Matchmaker.Domain.Results
@using Matchmaker.Web.Matches

<header class="match-header">
    <p class="badge">@StatusLabel</p>
    <h1>Partie du @Match.ProposedAt.ToString("dd/MM/yyyy")</h1>
    <p class="hint">
        @Match.First.Format.Name · @(Match.First.Ranked ? "classée" : "amicale")
        @if (Match.ConfirmedAutomatically)
        {
            @(" · résultat confirmé automatiquement")
        }
        @if (Match.ScheduledFor is { } start)
        {
            <text> · Partie prévue le <LocalTime Value="start" /></text>
        }
        @if (Match.Status == MatchStatus.Disputed)
        {
            @(" · résultat contesté, sans effet sur l'Elo")
        }
    </p>
</header>

<div class="match-sides">
    @foreach (var side in new[] { Match.First, Match.Second })
    {
        var player = Players.GetValueOrDefault(side.Player);
        var list = Archives.For(Match.Id, side.Player);
        <section class="card side">
            <h2>
                @if (player is not null)
                {
                    <PlayerLink Player="player" />
                }
                else
                {
                    @side.Player.SteamId
                }
            </h2>
            <p class="hint">
                @if (Match.RatingBeforeOf(side.Player) is { } before && Match.RatingChangeOf(side.Player) is { } change)
                {
                    @($"Elo {before} → {before + change}")
                    <span class="@(change >= 0 ? "gain" : "loss")">Elo @ResultLabels.Signed(change)</span>
                }
                else
                {
                    @($"Elo {side.Rating.Value} à la recherche")
                }
            </p>
            <p>
                Liste :
                @if (list is not null)
                {
                    <a href="/archived-lists/@list.Id"><Icon Name="eye" /> @list.Name</a>
                    <span class="hint">· @(list.Faction ?? "Faction inconnue")@(list.Detachment is { } detachment ? $" · {detachment}" : "")</span>
                }
                else
                {
                    <span class="hint">non archivée</span>
                }
            </p>
            <p class="score">@ScoreOf(side.Player)</p>
        </section>
    }
</div>

@code {
    [Parameter, EditorRequired] public Match Match { get; set; } = default!;
    [Parameter] public IReadOnlyDictionary<PlayerId, Player> Players { get; set; } = new Dictionary<PlayerId, Player>();
    [Parameter] public ArchivedLists Archives { get; set; } = ArchivedLists.None;

    private string StatusLabel => Match.Status switch
    {
        MatchStatus.Accepted => "Partie en cours",
        MatchStatus.ResultDeclared => "En attente de confirmation",
        MatchStatus.Disputed => "Résultat contesté",
        _ => "Partie terminée",
    };

    private string ScoreOf(PlayerId player)
    {
        switch (Match.Status)
        {
            case MatchStatus.Completed:
            {
                var score = Match.ScoreOf(player);
                return $"{Match.VictoryPointsOf(player)} VP · WTC {score.Points} · {ResultLabels.Of(score.Category)}";
            }
            case MatchStatus.Abandoned:
            {
                var score = Match.ScoreOf(player);
                return $"WTC {score.Points} · {ResultLabels.Of(score.Category)}{(Match.AbandonedBy == player ? " · Abandon" : "")}";
            }
            case MatchStatus.ResultDeclared or MatchStatus.Disputed:
                return $"{Match.VictoryPointsOf(player)} VP déclarés";
            default:
                return "Pas encore de score";
        }
    }
}
