# Copier en deploy/.env sur le serveur (jamais dans Git) puis compléter.

# Nom de domaine du site (sans https://, sans www).
DOMAIN=warhammer-matchmaker.com

# Adresse prévenue par Let's Encrypt en cas de souci de certificat.
ACME_EMAIL=

# Mot de passe de la base : lettres et chiffres uniquement (généré par bootstrap.sh).
POSTGRES_PASSWORD=

# Clé d'API Web Steam : https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Clés VAPID des notifications push (facultatives). Pour en générer :
# node -e 'const k=require("crypto").generateKeyPairSync("ec",{namedCurve:"P-256"}).privateKey.export({format:"jwk"});const b=s=>Buffer.from(s,"base64url");console.log("VAPID_PUBLIC_KEY="+Buffer.concat([Buffer.from([4]),b(k.x),b(k.y)]).toString("base64url")+"\nVAPID_PRIVATE_KEY="+k.d)'
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
